# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store (local, file-based — no SQL/DB server)
VECTOR_STORE_DIR=./data/vector_store

# RAG chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# AI Governance
ENABLE_PII_REDACTION=true
ENABLE_CONTENT_MODERATION=true
AUDIT_LOG_PATH=./data/audit_log.jsonl

# MCP
MCP_SERVER_NAME=rag-governance-mcp
MCP_SERVER_PORT=8765

# Azure (used only by CI/CD, not by the app directly)
AZURE_WEBAPP_NAME=your-azure-webapp-name
